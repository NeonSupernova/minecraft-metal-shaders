{
	"schemaVersion": 1,
	"id": "mcopt-metal",
	"version": "${version}",
	"name": "Metal Shaders (mcopt Metal)",
	"description": "Native Apple Metal rendering backend (mcopt) with native Metal shaders: shadows, volumetric clouds, god rays, reflective water, HDR.",
	"contact": { "sources": "https://github.com/GaelQuinta/minecraft-metal-shaders" },
	"license": ["Apache-2.0", "LicenseRef-PolyForm-Shield-1.0.0"],
	"authors": ["Noah Dunnagan", "Gael Quintanilla"],
	"environment": "client",
	"entrypoints": { "preLaunch": ["mcopt.metal.Preload"] },
	"mixins": ["mcopt-metal.mixins.json", "mcopt-metal-qos.mixins.json", "mcopt-metal-cpu.mixins.json", "mcopt-metal-chunk.mixins.json", "mcopt-metal-lod.mixins.json", "mcopt-metal-gen.mixins.json", "mcopt-metal-startup.mixins.json", "mcopt-metal-alloc.mixins.json", "mcopt-metal-probe.mixins.json", "mcopt-metal-chunkio.mixins.json", "mcopt-metal-edge.mixins.json", "mcopt-metal-shade.mixins.json", "mcopt-metal-shade-shadow.mixins.json", "mcopt-metal-shade-vl.mixins.json", "mcopt-metal-shade-light.mixins.json", "mcopt-metal-shade-dims.mixins.json", "mcopt-metal-compat.mixins.json"],
	"depends": { "fabricloader": ">=0.19.5", "minecraft": "~26.3", "java": ">=25", "sodium": ">=0.9.2-beta.1 <=0.9.3-alpha.1" }
}
